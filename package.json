{
  "name": "tierras",
  "version": "1.0.0",
  "private": true,
  "description": "Tierras — mapa de viajes compartido para grupos.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env SEED_DEMO=true node --watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.ts",
    "start:demo": "cross-env SEED_DEMO=true node server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/geo.test.ts tests/api.test.ts",
    "data": "node scripts/build-data.mjs",
    "icons": "python scripts/make-icons.py"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "d3-geo": "^3.1.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "all-the-cities": "^3.1.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "flag-icons": "^7.6.0",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
